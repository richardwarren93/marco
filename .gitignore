# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out/ is reused by Capacitor as the placeholder webDir; ignore generated
# next-export artifacts but keep the splash file.
/out/*
!/out/index.html

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Capacitor — generated native build artifacts
# We commit the platform sources (ios/, android/) so signing config and
# native customizations are tracked, but build outputs are derived.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/Podfile.lock
ios/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/

