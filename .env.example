# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Meta (Instagram scraping)
META_APP_ID=
META_APP_SECRET=

# Twilio — SMS interface (Text Marco)
# Account SID + auth token from https://console.twilio.com
# Phone number must be SMS-capable, in E.164 format, e.g. +15551234567
# After deploy, set the number's "A MESSAGE COMES IN" webhook to:
#   https://<your-domain>/api/webhooks/sms/receive  (HTTP POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public app URL — used in SMS replies for recipe deep links
NEXT_PUBLIC_APP_URL=https://marco-eta-lyart.vercel.app

# Instacart Developer Platform — "Order groceries" → shoppable list
# Get a key at https://dashboard.instacart.com (API Keys → Create New API Key).
# Leave blank to disable: the Order Online sheet falls back to copy + open store.
INSTACART_API_KEY=
# "development" hits the sandbox (connect.dev.instacart.tools, needs a dev key);
# anything else (or unset) uses production (connect.instacart.com).
INSTACART_ENV=production

# RevenueCat — Marco Plus in-app purchases (StoreKit via @revenuecat/purchases-capacitor)
# See PHASE2-SETUP.md for the full dashboard walkthrough.
# Public SDK key for the iOS app (starts with "appl_"). NEXT_PUBLIC_ = inlined at
# build time, so set it in Vercel and redeploy for the native shell to pick it up.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
# Shared secret you choose; set the same value as the Authorization header on the
# RevenueCat webhook (Dashboard → Integrations → Webhooks →
# https://<your-domain>/api/webhooks/revenuecat). Guards the entitlement-sync route.
REVENUECAT_WEBHOOK_SECRET=
