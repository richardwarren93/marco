<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Shared with the Share Extension so a shared recipe link survives even
	     when the marco:// deep link doesn't fire. Must stay identical to the
	     group in ShareExtension.entitlements and to
	     SharedImportStore.appGroupID. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ACGC.crave</string>
	</array>
</dict>
</plist>
