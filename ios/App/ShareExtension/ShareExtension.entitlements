<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same group as App.entitlements. This is the only capability the
	     extension needs: it writes the shared URL here and the app drains it.
	     No push, no keychain sharing, no network access. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ACGC.crave</string>
	</array>
</dict>
</plist>
